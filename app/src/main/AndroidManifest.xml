<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GameAgent"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            This is the core of the whole app. Once the user enables it in
            Settings > Accessibility, it can read the screen contents of
            whatever app is in the foreground and dispatch taps/swipes into
            it. That's the same mechanism screen readers use - it's the only
            legitimate way for a normal app to both "see" and "control"
            another app on modern Android without root.
        -->
        <service
            android:name=".GameAgentAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            The "eyes" of vision mode. Captures the actual screen pixels
            via MediaProjection - this works on ANY app, since unlike the
            accessibility tree it doesn't care whether what's on screen is
            native UI, a game engine's rendered canvas, or a video stream.
        -->
        <service
            android:name=".vision.VisionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".vision.InstructionReceiver"
            android:exported="false" />

    </application>
</manifest>
